#!/usr/bin/env python3
"""OpenVPN 管理中心的本机命令行工具。

不带参数时显示一个适合 SSH 使用的中文数字菜单；也支持 ``openvpn-manager 1`` 这类
数字快捷命令。需要特权的操作仍然通过
openvpn-manager-agent 的 Unix 域套接字执行。
"""

from __future__ import annotations

import argparse
import base64
import getpass
import hashlib
import json
import os
import re
import secrets
import socket
import sys
import textwrap
from typing import Any


SOCKET_PATH = os.environ.get("OPENVPN_MANAGER_SOCKET", "/run/openvpn-manager/agent.sock")


def b64encode(value: bytes) -> str:
    return base64.urlsafe_b64encode(value).rstrip(b"=").decode("ascii")


def hash_password(password: str) -> str:
    salt = secrets.token_bytes(16)
    digest = hashlib.scrypt(password.encode("utf-8"), salt=salt, n=16384, r=8, p=1, dklen=32)
    return f"scrypt$16384$8$1${b64encode(salt)}${b64encode(digest)}"


def request(payload: dict[str, Any]) -> Any:
    encoded = (json.dumps(payload, separators=(",", ":")) + "\n").encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(130)
        client.connect(SOCKET_PATH)
        client.sendall(encoded)
        chunks: list[bytes] = []
        while True:
            block = client.recv(65536)
            if not block:
                break
            chunks.append(block)
            if b"\n" in block:
                break
    first_line = b"".join(chunks).split(b"\n", 1)[0]
    response = json.loads(first_line)
    if not response.get("ok"):
        raise RuntimeError(response.get("error", "代理请求失败"))
    return response.get("data", {})


def print_json(value: Any) -> None:
    print(json.dumps(value, indent=2, ensure_ascii=False))


def value_or_dash(value: Any) -> str:
    if value in (None, ""):
        return "—"
    if isinstance(value, bool):
        return "是" if value else "否"
    return str(value)


def short_status(data: dict[str, Any]) -> None:
    if "service" in data:
        healthy = bool(data.get("healthy"))
        print(f"OpenVPN：{'正常' if healthy else '异常'}（{value_or_dash(data.get('service'))}）")
    if "endpoint" in data:
        print(f"公网地址：{value_or_dash(data.get('endpoint'))}")
        print(
            f"VPN：{value_or_dash(data.get('vpn_port'))}/"
            f"{str(data.get('vpn_protocol', '')).upper()}"
        )
        print(f"VPN 子网：{value_or_dash(data.get('vpn_subnet'))}")
        print(f"在线客户端：{value_or_dash(data.get('online_count'))}")
        print(f"OpenVPN 版本：{value_or_dash(data.get('version'))}")
    if "web_service" in data:
        print(f"管理面板：{value_or_dash(data.get('web_service'))}")
        print(f"Nginx：{value_or_dash(data.get('nginx_service'))}")
        print(
            "面板状态："
            + ("正常" if data.get("web_healthy") and data.get("nginx_healthy") else "异常")
        )


def show_clients(clients: list[dict[str, Any]]) -> None:
    if not clients:
        print("暂无有效客户端。")
        return
    headers = ("名称", "状态", "VPN 地址", "下级内网", "访问范围")
    rows: list[tuple[str, str, str, str, str]] = []
    for client in clients:
        status = "在线" if client.get("online") else "离线"
        lan = value_or_dash(client.get("lan_subnet"))
        if not client.get("lan_subnet"):
            access = "普通客户端"
        elif client.get("share_lan"):
            access = "其他客户端可访问"
        else:
            access = "仅服务端可访问"
        connection = client.get("connection") or {}
        rows.append(
            (
                str(client.get("name", "")),
                status,
                value_or_dash(connection.get("virtual_address")),
                lan,
                access,
            )
        )
    widths = [len(item) for item in headers]
    for row in rows:
        widths = [max(width, len(item)) for width, item in zip(widths, row)]
    print("  ".join(item.ljust(width) for item, width in zip(headers, widths)))
    print("  ".join("─" * width for width in widths))
    for row in rows:
        print("  ".join(item.ljust(width) for item, width in zip(row, widths)))


def show_settings(settings: dict[str, Any]) -> None:
    labels = (
        ("endpoint", "公网地址"),
        ("vpn_port", "VPN 端口"),
        ("vpn_protocol", "VPN 协议"),
        ("vpn_subnet", "VPN 子网"),
        ("dns_servers", "DNS"),
        ("redirect_gateway", "全流量转发"),
        ("max_clients", "最大客户端数"),
        ("web_port", "管理端口"),
        ("web_allow", "控制台来源"),
        ("tun_mtu", "TUN MTU"),
        ("mssfix", "MSS Fix"),
        ("keepalive_ping", "Keepalive 检测"),
        ("keepalive_timeout", "Keepalive 超时"),
        ("data_cipher", "数据加密"),
        ("auth_digest", "HMAC 摘要"),
        ("log_verb", "日志等级"),
        ("push_routes", "推送路由"),
    )
    for key, label in labels:
        value = settings.get(key)
        if isinstance(value, list):
            value = ", ".join(str(item) for item in value) or "—"
        print(f"{label}：{value_or_dash(value)}")


def show_web_settings(settings: dict[str, Any]) -> None:
    password_status = "已配置（不会显示密码明文或哈希）" if settings.get("password_configured") else "未正确配置"
    print(f"面板用户名：{value_or_dash(settings.get('admin_user'))}")
    print(f"密码状态：{password_status}")
    print(f"会话有效期：{value_or_dash(settings.get('session_hours'))} 小时")
    print(f"HTTPS 端口：{value_or_dash(settings.get('web_port'))}")
    print(f"允许来源：{value_or_dash(settings.get('web_allow'))}")
    print(f"TLS 证书：{value_or_dash(settings.get('tls_certificate'))}")
    print(f"面板服务：{value_or_dash(settings.get('web_service'))}")


def edit_web_credentials(*, username: str | None = None) -> None:
    current = request({"action": "web_settings"})
    current_user = str(current.get("admin_user") or "admin")
    new_user = username.strip() if isinstance(username, str) else input(f"新面板用户名 [{current_user}]：").strip()
    new_user = new_user or current_user
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,31}", new_user):
        raise ValueError("用户名格式无效：请使用字母、数字、点、下划线或短横线，最长 32 个字符")
    new_password = getpass.getpass("新面板密码（留空表示不修改）：")
    encoded_hash = None
    if new_password:
        if len(new_password) < 12 or len(new_password) > 128:
            raise ValueError("面板密码长度必须为 12 到 128 个字符")
        confirmation = getpass.getpass("再次输入新密码：")
        if new_password != confirmation:
            raise ValueError("两次输入的密码不一致")
        encoded_hash = hash_password(new_password)
    if new_user == current_user and encoded_hash is None:
        print("没有修改用户名或密码。")
        return
    print(f"\n用户名：{current_user} → {new_user}")
    if encoded_hash is not None:
        print("密码：将更新（不会显示明文）")
    if input("确认保存并重启管理面板？请输入 YES：").strip() != "YES":
        print("已取消。")
        return
    result = request({
        "action": "set_web_credentials",
        "username": new_user,
        "password_hash": encoded_hash,
    })
    print(result.get("message") or "面板登录配置已更新，现有登录会话已失效，请使用新凭据重新登录。")


def prompt_setting(label: str, current: Any, *, clearable: bool = False) -> Any:
    if isinstance(current, list):
        display = ", ".join(str(item) for item in current) or "空"
    else:
        display = value_or_dash(current)
    suffix = "；输入 - 清空" if clearable else ""
    raw = input(f"{label} [{display}]{suffix}：").strip()
    if not raw:
        return None
    if clearable and raw in {"-", "清空"}:
        return []
    return raw


def prompt_bool_setting(label: str, current: Any) -> Any:
    default = "是" if current else "否"
    while True:
        raw = input(f"{label} [{default}]（y/n）：").strip().lower()
        if not raw:
            return None
        if raw in {"y", "yes", "1", "是", "true"}:
            return True
        if raw in {"n", "no", "0", "否", "false"}:
            return False
        print("请输入 y 或 n。")


def split_list_input(value: Any) -> list[str]:
    if isinstance(value, str):
        return [item for item in re.split(r"[,\s]+", value.strip()) if item]
    return list(value) if isinstance(value, (list, tuple)) else []


def edit_server_settings() -> None:
    current = request({"action": "server_settings"})
    print("\n修改服务端设置；直接回车保留当前值。")
    print("注意：保存后会重新生成客户端配置并重启 OpenVPN，当前连接会短暂中断。")
    payload: dict[str, Any] = {}
    fields = (
        ("endpoint", "公网地址或域名", False),
        ("vpn_port", "VPN 端口", False),
        ("vpn_protocol", "VPN 协议（udp/tcp）", False),
        ("vpn_subnet", "VPN 私有子网", False),
        ("dns_servers", "DNS（逗号或空格分隔）", True),
        ("max_clients", "最大客户端数", False),
        ("web_allow", "控制台允许来源 CIDR", False),
        ("tun_mtu", "TUN MTU", False),
        ("mssfix", "MSS Fix（0 关闭）", False),
        ("keepalive_ping", "Keepalive 检测间隔", False),
        ("keepalive_timeout", "Keepalive 超时", False),
        ("data_cipher", "数据加密", False),
        ("auth_digest", "HMAC 摘要", False),
        ("log_verb", "日志等级", False),
        ("push_routes", "推送路由（逗号或空格分隔）", True),
    )
    for key, label, clearable in fields:
        value = prompt_setting(label, current.get(key), clearable=clearable)
        if value is not None:
            if key in {"dns_servers", "push_routes"}:
                value = split_list_input(value)
            payload[key] = value
    redirect = prompt_bool_setting("让客户端全部流量经过 VPN", current.get("redirect_gateway", True))
    if redirect is not None:
        payload["redirect_gateway"] = redirect
    if not payload:
        print("没有修改任何设置。")
        return
    print("\n即将应用以下变更：")
    preview = dict(current)
    preview.update(payload)
    show_settings(preview)
    if input("确认保存并重启 OpenVPN？请输入 YES：").strip() != "YES":
        print("已取消。")
        return
    result = request({"action": "update_server_settings", "settings": payload})
    print("服务端设置已应用。")
    if isinstance(result, dict) and isinstance(result.get("status"), dict):
        short_status(result["status"])


def print_logs(data: dict[str, Any]) -> None:
    lines = data.get("lines", []) if isinstance(data, dict) else []
    print("\n".join(str(line) for line in lines) if lines else "暂无日志。")


def print_update(data: dict[str, Any]) -> None:
    print(f"当前面板：{value_or_dash(data.get('current_manager_version'))}")
    print(f"远程面板：{value_or_dash(data.get('latest_manager_version'))}")
    print(f"当前 OpenVPN：{value_or_dash(data.get('current_openvpn_version'))}")
    print(f"软件源版本：{value_or_dash(data.get('candidate_openvpn_version'))}")
    print(f"更新状态：{'有更新' if data.get('update_available') else '已是最新'}")
    if data.get("release_name"):
        print(f"发布名称：{data['release_name']}")
    if data.get("release_published_at"):
        print(f"发布时间：{data['release_published_at']}")
    if data.get("release_url"):
        print(f"发布地址：{data['release_url']}")
    if data.get("check_warning"):
        print(f"提示：{data['check_warning']}")
    notes = str(data.get("release_notes") or "").strip()
    if notes:
        print("更新日志：")
        print(textwrap.indent(notes, "  "))


def print_update_status(data: dict[str, Any]) -> None:
    print(f"更新任务：{value_or_dash(data.get('state'))}")
    if data.get("message"):
        print(f"说明：{data['message']}")
    if data.get("target_version"):
        print(f"目标版本：{data['target_version']}")
    if data.get("updated_at"):
        print(f"更新时间：{data['updated_at']}")


def prompt_share_lan() -> bool:
    return input("是否允许其他 VPN 客户端访问？[y/N] ").strip().lower() in {"y", "yes"}


def handle_choice(choice: str) -> bool:
    """Execute one menu number. Return False when the caller should exit."""
    if choice == "0":
        return False
    if choice == "1":
        short_status(request({"action": "panel_restart"}))
    elif choice == "2":
        short_status(request({"action": "panel_stop"}))
    elif choice == "3":
        short_status(request({"action": "panel_start"}))
    elif choice == "4":
        short_status(request({"action": "panel_restart"}))
    elif choice == "5":
        short_status(request({"action": "restart"}))
    elif choice == "6":
        short_status(request({"action": "stop"}))
    elif choice == "7":
        short_status(request({"action": "start"}))
    elif choice == "8":
        short_status(request({"action": "apply"}))
    elif choice == "9":
        short_status(request({"action": "status"}))
    elif choice == "10":
        short_status(request({"action": "panel_status"}))
    elif choice == "11":
        show_clients(request({"action": "list_clients"}))
    elif choice == "12":
        name = input("客户端名称：").strip()
        lan = input("下级内网 CIDR（可留空）：").strip()
        share = prompt_share_lan() if lan else False
        print_json(request({"action": "create_client", "name": name, "lan_subnet": lan, "share_lan": share}))
    elif choice == "13":
        name = input("客户端名称：").strip()
        print_json(request({"action": "get_profile", "name": name}))
    elif choice == "14":
        name = input("客户端名称：").strip()
        lan = input("下级内网 CIDR（留空表示移除）：").strip()
        share = prompt_share_lan() if lan else False
        print_json(request({"action": "set_client_network", "name": name, "lan_subnet": lan, "share_lan": share}))
    elif choice == "15":
        name = input("客户端名称：").strip()
        print_json(request({"action": "disconnect_client", "name": name}))
    elif choice == "16":
        name = input("客户端名称：").strip()
        if input(f"确认吊销并删除 {name}？请输入 YES：").strip() == "YES":
            print_json(request({"action": "revoke_client", "name": name}))
        else:
            print("已取消。")
    elif choice == "17":
        show_settings(request({"action": "server_settings"}))
    elif choice == "18":
        edit_server_settings()
    elif choice == "19":
        print_logs(request({"action": "logs", "lines": 120}))
    elif choice == "20":
        name = input("客户端名称：").strip()
        print_logs(request({"action": "client_logs", "name": name, "lines": 120}))
    elif choice == "21":
        print_update(request({"action": "check_updates", "force": True}))
    elif choice == "22":
        print_update_status(request({"action": "start_update"}))
    elif choice == "23":
        print_update_status(request({"action": "update_status"}))
    elif choice == "24":
        show_web_settings(request({"action": "web_settings"}))
    elif choice == "25":
        edit_web_credentials()
    else:
        print("无效选项，请重新输入。")
    return True


def menu_header() -> None:
    cyan = "\033[1;36m" if sys.stdout.isatty() else ""
    yellow = "\033[1;33m" if sys.stdout.isatty() else ""
    reset = "\033[0m" if sys.stdout.isatty() else ""
    print(f"{cyan}{'=' * 78}{reset}")
    print(f"{cyan}                         OpenVPN 管理中心命令行{reset}")
    print(f"{cyan}{'=' * 78}{reset}")
    print("(1) 重启管理面板                         (2) 停止管理面板")
    print("(3) 启动管理面板                         (4) 重载管理面板")
    print("(5) 重启 OpenVPN 服务                    (6) 停止 OpenVPN 服务")
    print("(7) 启动 OpenVPN 服务                    (8) 应用配置并重启")
    print("(9) 查看 OpenVPN 状态                    (10) 查看管理面板状态")
    print("(11) 查看客户端列表                       (12) 新建客户端")
    print("(13) 查看客户端配置                       (14) 设置客户端下级内网")
    print("(15) 踢出当前客户端                       (16) 吊销并删除客户端")
    print("(17) 查看服务端设置                       (18) 修改服务端设置")
    print("(19) 查看 OpenVPN 日志                    (20) 查看客户端日志")
    print("(21) 检查远程更新                         (22) 更新面板与 OpenVPN")
    print("(23) 查看更新任务状态                     (24) 查看面板配置")
    print("(25) 修改面板用户名和密码")
    print(f"{yellow}(0) 退出{reset}")
    print(f"{cyan}{'=' * 78}{reset}")


def interactive_menu() -> int:
    """Show a compact interactive menu similar to common server panels."""
    while True:
        print()
        menu_header()
        try:
            choice = input("请输入对应的数字并按回车：").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        try:
            keep_running = handle_choice(choice)
        except (OSError, ValueError, RuntimeError) as exc:
            print(f"错误：{exc}", file=sys.stderr)
            keep_running = True
        except KeyboardInterrupt:
            print("\n已取消当前操作。")
            keep_running = True
        if not keep_running:
            return 0
        try:
            input("\n按回车返回菜单…")
        except (EOFError, KeyboardInterrupt):
            return 0


def numeric_shortcut(choice: str) -> int:
    try:
        if not handle_choice(choice):
            return 0
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"错误：{exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n已取消当前操作。", file=sys.stderr)
        return 130
    return 0


def main() -> int:
    if len(sys.argv) == 1:
        return interactive_menu()
    if sys.argv[1].isdigit() and 0 <= int(sys.argv[1]) <= 25:
        return numeric_shortcut(sys.argv[1])

    parser = argparse.ArgumentParser(description="管理本机 OpenVPN 服务")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("menu", aliases=["ui"], help="打开交互式命令行菜单")
    sub.add_parser("panel-status", help="查看管理面板与 Nginx 状态")
    sub.add_parser("panel-start", help="启动管理面板与 Nginx")
    sub.add_parser("panel-stop", help="停止管理面板服务")
    sub.add_parser("panel-restart", aliases=["panel-reload"], help="重启管理面板并 reload Nginx")
    sub.add_parser("start", help="启动 OpenVPN")
    sub.add_parser("stop", help="停止 OpenVPN")
    sub.add_parser("apply", aliases=["reload"], help="重新生成配置并重启 OpenVPN")
    sub.add_parser("settings", help="查看服务端设置")
    sub.add_parser("web-settings", help="查看面板配置（不会显示密码明文或哈希）")
    web_credentials = sub.add_parser("web-credentials", help="修改面板用户名和密码")
    web_credentials.add_argument("--username", help="新面板用户名；省略时交互输入")
    sub.add_parser("check-update", help="强制检查远程版本与更新日志")
    sub.add_parser("edit-settings", help="交互式修改服务端设置")
    sub.add_parser("status")
    sub.add_parser("list")
    create = sub.add_parser("create")
    create.add_argument("name")
    create.add_argument("--lan-subnet", default="")
    create.add_argument("--share-lan", action="store_true")
    network = sub.add_parser("network")
    network.add_argument("name")
    network.add_argument("lan_subnet", nargs="?", default="")
    network.add_argument("--share-lan", action="store_true")
    disconnect = sub.add_parser("disconnect")
    disconnect.add_argument("name")
    profile = sub.add_parser("profile")
    profile.add_argument("name")
    revoke = sub.add_parser("revoke")
    revoke.add_argument("name")
    logs = sub.add_parser("logs")
    logs.add_argument("lines", nargs="?", type=int, default=100)
    client_logs = sub.add_parser("client-logs")
    client_logs.add_argument("name")
    client_logs.add_argument("lines", nargs="?", type=int, default=120)
    sub.add_parser("restart")
    sub.add_parser("update")
    sub.add_parser("update-status")
    args = parser.parse_args()

    if args.command in {"menu", "ui"}:
        return interactive_menu()
    if args.command == "edit-settings":
        try:
            edit_server_settings()
            return 0
        except (OSError, ValueError, RuntimeError) as exc:
            print(f"错误：{exc}", file=sys.stderr)
            return 1
    if args.command == "web-credentials":
        try:
            edit_web_credentials(username=args.username)
            return 0
        except (OSError, ValueError, RuntimeError) as exc:
            print(f"错误：{exc}", file=sys.stderr)
            return 1

    actions: dict[str, dict[str, Any]] = {
        "status": {"action": "status"},
        "start": {"action": "start"},
        "stop": {"action": "stop"},
        "apply": {"action": "apply"},
        "reload": {"action": "apply"},
        "panel-status": {"action": "panel_status"},
        "panel-start": {"action": "panel_start"},
        "panel-stop": {"action": "panel_stop"},
        "panel-restart": {"action": "panel_restart"},
        "panel-reload": {"action": "panel_restart"},
        "settings": {"action": "server_settings"},
        "web-settings": {"action": "web_settings"},
        "check-update": {"action": "check_updates", "force": True},
        "list": {"action": "list_clients"},
        "create": {
            "action": "create_client",
            "name": getattr(args, "name", ""),
            "lan_subnet": getattr(args, "lan_subnet", ""),
            "share_lan": getattr(args, "share_lan", False),
        },
        "network": {
            "action": "set_client_network",
            "name": getattr(args, "name", ""),
            "lan_subnet": getattr(args, "lan_subnet", ""),
            "share_lan": getattr(args, "share_lan", False),
        },
        "disconnect": {"action": "disconnect_client", "name": getattr(args, "name", "")},
        "profile": {"action": "get_profile", "name": getattr(args, "name", "")},
        "revoke": {"action": "revoke_client", "name": getattr(args, "name", "")},
        "logs": {"action": "logs", "lines": getattr(args, "lines", 100)},
        "client-logs": {
            "action": "client_logs",
            "name": getattr(args, "name", ""),
            "lines": getattr(args, "lines", 120),
        },
        "restart": {"action": "restart"},
        "update": {"action": "start_update"},
        "update-status": {"action": "update_status"},
    }
    try:
        result = request(actions[args.command])
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"错误：{exc}", file=sys.stderr)
        return 1

    display_status_commands = {
        "status",
        "start",
        "stop",
        "apply",
        "reload",
        "restart",
        "panel-status",
        "panel-start",
        "panel-stop",
        "panel-restart",
        "panel-reload",
    }
    if args.command in display_status_commands:
        short_status(result)
    elif args.command == "list":
        show_clients(result)
    elif args.command == "settings":
        show_settings(result)
    elif args.command == "web-settings":
        show_web_settings(result)
    elif args.command in {"logs", "client-logs"}:
        print_logs(result)
    elif args.command == "check-update":
        print_update(result)
    elif args.command in {"update", "update-status"}:
        print_update_status(result)
    elif isinstance(result, (dict, list)):
        print_json(result)
    else:
        print(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
