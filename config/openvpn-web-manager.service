[Unit]
Description=OpenVPN Web Manager web service
After=network-online.target openvpn-manager-agent.service
Wants=network-online.target
Requires=openvpn-manager-agent.service

[Service]
Type=simple
User=openvpn-web
Group=openvpn-web
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENVPN_MANAGER_CONFIG=/etc/openvpn-manager/server.json
Environment=OPENVPN_MANAGER_WEB_CONFIG=/etc/openvpn-manager/web.json
Environment=OPENVPN_MANAGER_SOCKET=/run/openvpn-manager/agent.sock
ExecStart=/usr/bin/python3 /opt/openvpn-web-manager/backend/server.py --host 127.0.0.1 --port 9090
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/openvpn-manager /var/lib/openvpn-manager /opt/openvpn-web-manager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
