[Unit]
Description=OpenVPN Web Manager privileged agent
After=network-online.target openvpn-server@server.service
Wants=network-online.target
Requires=openvpn-server@server.service

[Service]
Type=simple
User=root
Group=openvpn-web
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENVPN_MANAGER_CONFIG=/etc/openvpn-manager/server.json
Environment=OPENVPN_MANAGER_WEB_CONFIG=/etc/openvpn-manager/web.json
Environment=OPENVPN_MANAGER_SOCKET=/run/openvpn-manager/agent.sock
ExecStart=/usr/bin/python3 /opt/openvpn-web-manager/backend/agent.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=openvpn-manager
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/openvpn/server /etc/openvpn-manager /var/lib/openvpn/server /var/lib/openvpn-manager /var/log/openvpn /run/openvpn-manager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
